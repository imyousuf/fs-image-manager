[Unit]
Description=fs-image-manager (serve) - media library HTTP server
Documentation=https://github.com/imyousuf/fs-image-manager
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Dedicated unprivileged user; create with:
#   sudo useradd --system --home /var/lib/fs-image-manager --shell /usr/sbin/nologin fsim
User=fsim
Group=fsim
ExecStart=/usr/local/bin/fs-image-manager serve -config /etc/fs-image-manager/image-manager.cfg
Restart=on-failure
RestartSec=5s
# Working dir holds the sqlite DB and derivative cache (per config).
WorkingDirectory=/var/lib/fs-image-manager
StateDirectory=fs-image-manager
# Self-update replaces /usr/local/bin/fs-image-manager and restarts this unit;
# allow the service user to manage its own restart via the helper below.

# --- Hardening (relax if a sandbox option blocks media library access) ---
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=read-only
PrivateTmp=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
# ReadWritePaths must include the DB/cache dir and any library roots that
# accept uploads. Adjust to match [libraries] and [cache] in your config.
ReadWritePaths=/var/lib/fs-image-manager

[Install]
WantedBy=multi-user.target
